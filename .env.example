# ELECHUB Environment Configuration Template
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=elechub-production-secret-change-me-2026
ADMIN_PASSWORD=your-secure-admin-password
DATABASE_URL=sqlite:///elechub.db

# Module 2: Bulk SMS Gateway (Africa's Talking)
AFRICA_TALKING_USERNAME=your_at_username
AFRICA_TALKING_API_KEY=atsk_your_api_key_here
AFRICA_TALKING_SENDER_ID=

# Module 3: Bulk Email Gateway (SMTP over TLS/SSL)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_DEFAULT_SENDER=ELECHUB Campaign Command <your_email@gmail.com>
